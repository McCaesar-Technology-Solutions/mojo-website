# Copy to .env.local for local development. Never commit real keys.
# Client-safe (Vite injects VITE_*)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=233XXXXXXXXX
VITE_APP_ENV=local

# Server-only — never prefix with VITE_ and never commit these
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
ADMIN_NOTIFY_EMAIL=ops@mojoapartments.com
SENTRY_DSN=

# APP_ENV / VITE_APP_ENV: local | preview | staging | production
APP_ENV=local
